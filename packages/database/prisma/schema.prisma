generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VOLUNTEER
  ORGANIZATION_ADMIN
  PLATFORM_ADMIN
  SUPPORT
}

model User {
  id             String                   @id @default(uuid())
  email          String                   @unique
  displayName    String                   @map("display_name")
  passwordHash   String                   @map("password_hash")
  role           UserRole                 @default(VOLUNTEER)
  mfaEnabled     Boolean                  @default(false) @map("mfa_enabled")
  memberships    OrganizationMembership[]
  resetTokens    PasswordResetToken[]
  recoveryCodes  MfaRecoveryCode[]
  sessions       Session[]
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model Organization {
  id          String                   @id @default(uuid())
  name        String
  memberships OrganizationMembership[]
  tasks       Task[]
  createdAt   DateTime                 @default(now()) @map("created_at")

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           UserRole
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_memberships")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  title          String
  status         String       @default("OPEN")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tasks")
}


model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model MfaRecoveryCode {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  codeHash String    @unique @map("code_hash")
  usedAt   DateTime? @map("used_at")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_recovery_codes")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorUserId    String?  @map("actor_user_id")
  organizationId String?  @map("organization_id")
  action         String
  correlationId  String   @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    @map("event_type")
  payload     Json
  attempts    Int       @default(0)
  processed   Boolean   @default(false)
  availableAt DateTime  @default(now()) @map("available_at")
  claimedAt DateTime? @map("claimed_at")
  claimExpiresAt DateTime? @map("claim_expires_at")
  claimToken String? @map("claim_token")
  processedAt DateTime? @map("processed_at")
  lastError   String?   @map("last_error")

  @@index([processed, availableAt, claimExpiresAt])
  @@index([claimToken])
  @@map("outbox_events")
}


model Notification {
  id            String   @id @default(uuid())
  outboxEventId String?  @unique @map("outbox_event_id")
  userId    String?  @map("user_id")
  channel   String   @default("EMAIL")
  recipient String
  subject   String
  body      String
  status    String   @default("PENDING")
  attempts  Int      @default(0)
  sentAt    DateTime? @map("sent_at")
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("notifications")
}

model DeadLetterEvent {
  id        String   @id @default(uuid())
  outboxId  String?  @map("outbox_id")
  eventType String   @map("event_type")
  payload   Json
  error     String
  attempts  Int
  failedAt  DateTime @default(now()) @map("failed_at")

  @@map("dead_letter_events")
}
